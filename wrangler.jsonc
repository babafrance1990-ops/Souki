{
  "name": "souki",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "souki-db",
      "database_id": "COLLEZ-ICI-L-ID-DE-LA-BASE-D1"
    }
  ]
}
