{
  "name": "souki",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "bi3li.net", "custom_domain": true },
    { "pattern": "www.bi3li.net", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/"]
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ADMIN_PHONES": "37264646",
    "SUPPORT_WHATSAPP": "22237264646"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "vendsmoi-media"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "souki-db",
      "database_id": "6a9fda01-fcaf-45eb-96e4-68f554832170"
    }
  ]
}
