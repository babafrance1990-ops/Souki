{
  "name": "souki",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/"]
  },
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ADMIN_PHONES": "37264646",
    "SUPPORT_WHATSAPP": "22237264646"
  },
  "r2_buckets": [
    {
      "binding": "MEDIA"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "souki-db",
      "database_id": "6a9fda01-fcaf-45eb-96e4-68f554832170"
    }
  ]
}
